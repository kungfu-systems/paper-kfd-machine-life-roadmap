\hypersetup{
  colorlinks=true,
  linkcolor=MLIndigo,
  citecolor=MLIndigo,
  urlcolor=MLIndigo,
  pdfborder={0 0 0}
}

\AtBeginDocument{\RaggedRight\pagecolor{MLPaper}\color{MLInk}}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.48em}
\setlength{\emergencystretch}{1.6em}
\setlength{\tabcolsep}{6pt}
\renewcommand{\arraystretch}{1.24}

\setlist[itemize]{
  leftmargin=1.28em,
  itemsep=0.3em,
  topsep=0.4em,
  label=\textcolor{MLIndigo}{\small\textbullet}
}
\setlist[enumerate]{leftmargin=1.62em,itemsep=0.32em,topsep=0.42em}

\titleformat{\section}[display]
  {\rmfamily\bfseries\color{MLInk}}
  {\sffamily\bfseries\fontsize{8.5}{10}\selectfont\color{MLIndigo}
    FIELD \thesection}
  {0.08in}
  {\fontsize{24.5}{27.5}\selectfont}
\titlespacing*{\section}{0pt}{0.08in}{0.19in}

\titleformat{\subsection}
  {\sffamily\bfseries\fontsize{13.2}{15.3}\selectfont\color{MLInk}}
  {\color{MLIndigo}\thesubsection}
  {0.62em}
  {}
\titlespacing*{\subsection}{0pt}{0.2in}{0.07in}

\titleformat{\paragraph}[runin]
  {\sffamily\bfseries\color{MLIndigo}}
  {}
  {0pt}
  {}
  [.]
\titlespacing*{\paragraph}{0pt}{0.7em}{0.42em}

\pagestyle{fancy}
\fancyhf{}
\lhead{\sffamily\bfseries\scriptsize\color{MLIndigo}MACHINE LIFE}
\rhead{\sffamily\scriptsize\color{MLMuted}\nouppercase{\leftmark}}
\lfoot{\sffamily\scriptsize\color{MLMuted}Kungfu Origin Technology Limited}
\rfoot{\sffamily\bfseries\scriptsize\color{MLIndigo}\thepage}
\renewcommand{\sectionmark}[1]{\markboth{\thesection\quad #1}{}}
\renewcommand{\headrule}{%
  \hbox to\headwidth{\color{MLLine}\leaders\hrule height 0.6pt\hfill}}
\renewcommand{\footrule}{%
  \hbox to\headwidth{\color{MLLine}\leaders\hrule height 0.6pt\hfill}}
\fancypagestyle{plain}{\pagestyle{fancy}}

\captionsetup{
  font={sf,small},
  labelfont={bf,color=MLIndigo},
  textfont={color=MLMuted},
  justification=raggedright,
  singlelinecheck=false,
  skip=7pt
}

\newcommand{\mleyebrow}[1]{%
  {\sffamily\bfseries\footnotesize\color{MLPeriwinkle}\MakeUppercase{#1}}%
}

\newcommand{\mlpaperlabel}[1]{%
  {\sffamily\bfseries\footnotesize\color{MLIndigo}\MakeUppercase{#1}}%
}

\newcommand{\claimbadge}[2]{%
  \leavevmode\raisebox{0.12ex}{\colorbox{#1}{%
    \strut\hspace{0.35em}{\sffamily\bfseries\scriptsize\color{MLWhite}#2}\hspace{0.35em}}}%
  \hspace{0.45em}%
}

\newtcolorbox{mlsoftcard}[1][]{
  enhanced,
  colback=MLPanel,
  colframe=MLLine,
  boxrule=0.6pt,
  arc=2.2mm,
  left=3.6mm,right=3.6mm,top=3.1mm,bottom=3.1mm,
  #1
}

\newtcolorbox{mldarkcard}[1][]{
  enhanced,
  colback=MLNight,
  colframe=MLNight,
  boxrule=0pt,
  arc=2.4mm,
  left=4.2mm,right=4.2mm,top=3.6mm,bottom=3.6mm,
  before upper={\color{MLWhite}\hypersetup{urlcolor=MLPeriwinkle,citecolor=MLPeriwinkle}},
  #1
}

\newtcolorbox{mlabstractbox}{
  enhanced,
  colback=MLPanel,
  colframe=MLLine,
  borderline west={3pt}{0pt}{MLIndigo},
  boxrule=0.6pt,
  arc=2.2mm,
  left=4.5mm,right=4.5mm,top=4mm,bottom=4mm
}

\newtcolorbox{mlstatebox}{
  enhanced,
  colback=MLPanel,
  colframe=MLPeriwinkle,
  boxrule=0.7pt,
  arc=2.2mm,
  left=4mm,right=4mm,top=2.7mm,bottom=2.7mm
}

\newcommand{\mlfrontcard}[2]{%
  \begin{mlsoftcard}
    {\sffamily\bfseries\footnotesize\color{MLIndigo}\MakeUppercase{#1}}\par
    \vspace{0.05in}{\small\color{MLInk}#2}
  \end{mlsoftcard}%
}

\newcommand{\mlmechanism}[2]{%
  \begin{mlsoftcard}[borderline north={2.2pt}{0pt}{MLIndigo}]
    {\sffamily\bfseries\fontsize{13}{15}\selectfont\color{MLInk}#1}\par
    {\small\color{MLMuted}#2}
  \end{mlsoftcard}%
}

\newcommand{\mlpartband}[2]{%
  \begin{tcolorbox}[
    enhanced,
    colback=MLPaperSoft,
    colframe=MLLine,
    boxrule=0.6pt,
    arc=1.8mm,
    left=3.5mm,right=3.5mm,top=2.5mm,bottom=2.5mm]
    {\sffamily\bfseries\scriptsize\color{MLIndigo}\MakeUppercase{#1}}\hfill
    {\rmfamily\bfseries\color{MLInk}#2}
  \end{tcolorbox}%
}

\newcommand{\mltrialcard}[3]{%
  \begin{minipage}[t]{0.315\textwidth}
  \begin{mlsoftcard}[height=1.92in,valign=top]
    {\sffamily\bfseries\fontsize{19}{21}\selectfont\color{MLIndigo}#1}\par
    {\sffamily\bfseries\small\color{MLInk}#2}\par
    \vspace{0.05in}{\scriptsize\color{MLMuted}#3}
  \end{mlsoftcard}
  \end{minipage}%
}

\newcommand{\mlclaimkey}[3]{%
  \claimbadge{#1}{#2}\par
  \vspace{0.05in}{\small\color{MLInk}#3}%
}

\newenvironment{mlagentprompt}{%
  \par\vspace{0.18em}\begingroup\small\ttfamily\color{MLWhite}\RaggedRight
}{%
  \par\endgroup
}

\newcommand{\mlstatuschip}[2]{%
  \tcbox[on line,colback=#1!10,colframe=#1!60,boxrule=0.5pt,arc=1.2mm,
    left=1.3mm,right=1.3mm,top=0.7mm,bottom=0.7mm]{%
    \sffamily\bfseries\scriptsize\color{#1}#2}%
}
