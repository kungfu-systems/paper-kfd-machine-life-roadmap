\definecolor{MLInk}{HTML}{121722}
\definecolor{MLNight}{HTML}{101417}
\definecolor{MLMuted}{HTML}{5B6670}
\definecolor{MLLine}{HTML}{D8D4CC}
\definecolor{MLIndigo}{HTML}{4F6094}
\definecolor{MLPeriwinkle}{HTML}{9DAAE0}
